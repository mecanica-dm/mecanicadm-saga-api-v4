MONGODB_URI=mongodb://localhost:27017/saga_db?directConnection=true

SPRING_PROFILES_ACTIVE=default

# Segredo do JWT: o mesmo da Workorder API, que emite o token (login). Troque em producao.
JWT_SECRET=development

BROKER_HOST=
BROKER_PORT=5672
BROKER_USER=guest
BROKER_PASSWORD=guest
BROKER_VHOST=/
BROKER_SSL_ENABLED=false

OUTBOX_SCHEDULER_ENABLED=true
OUTBOX_PUBLISHER_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_CONFIRM_TIMEOUT_MS=5000
OUTBOX_RETENTION_DAYS=7
OUTBOX_CLEANUP_CRON=0 0 3 * * *

CONSUMER_PREFETCH=10
